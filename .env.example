# Interface to bind. Defaults to 127.0.0.1 (loopback only) - this is a custodial
# wallet API, so reaching it from another machine has to be opted into, not
# arrived at by forgetting a variable. Set to 0.0.0.0 to expose it, and put
# authentication-aware fronting (and TRUST_PROXY below) in place if you do.
HOST=
PORT=3000
BITCOIND_RPC=http://login:password@127.0.0.1:8332
# Number of reverse proxies in front of this server, if any. Leave unset when
# clients connect directly: trusting a proxy means req.ip is read from the
# client-supplied X-Forwarded-For header, and every rate limit can then be
# sidestepped by sending a different one each request. Set to 1 behind a single
# nginx/Caddy, or to an Express trust list ('loopback', a CIDR) if you need one.
TRUST_PROXY=
REDIS_PORT=6379
REDIS_HOST=127.0.0.1
REDIS_FAMILY=4
REDIS_DB=0
LND_URL=localhost:10009
# Only needed if your LND wallet starts locked and needs auto-unlocking on boot
LND_WALLET_PASSWORD=
# Optional: hex-encoded TLS cert / macaroon, overrides reading tls.cert / admin.macaroon from disk
TLSCERT=
MACAROON=
# YubiKey OTP support (optional second factor on /auth). Get a free Client ID +
# Secret Key at https://upgrade.yubico.com/getapikey/ - required for OTP verification
# to work at all, regardless of which mechanism below is used.
YUBICO_CLIENT_ID=
YUBICO_SECRET_KEY=
# Preferred: accounts self-enroll a YubiKey via `npm run login:enroll` (POST
# /yubikey/enroll), stored per-account in Redis - no env var needed per account.
# The two vars below are a static, global fallback/override, useful for bootstrapping
# before self-enrollment exists or for keys that must apply outside any one account:
# comma-separated `login` values that must present a YubiKey OTP to log in, and
# comma-separated YubiKey public IDs (first 12 chars of an OTP) accepted for them.
YUBICO_REQUIRED_LOGINS=
YUBICO_ALLOWED_PUBLIC_IDS=
