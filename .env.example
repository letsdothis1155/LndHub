BITCOIND_RPC=http://login:password@127.0.0.1:8332
REDIS_PORT=6379
REDIS_HOST=127.0.0.1
REDIS_FAMILY=4
REDIS_DB=0
LND_URL=localhost:10009
# Only needed if your LND wallet starts locked and needs auto-unlocking on boot
LND_WALLET_PASSWORD=
# Optional: hex-encoded TLS cert / macaroon, overrides reading tls.cert / admin.macaroon from disk
TLSCERT=
MACAROON=
# Optional: require a YubiKey OTP (in addition to password) to log in with specific accounts.
# Get a free Client ID + Secret Key at https://upgrade.yubico.com/getapikey/
YUBICO_CLIENT_ID=
YUBICO_SECRET_KEY=
# Comma-separated `login` values (as returned by /create) that must present a YubiKey OTP to log in
YUBICO_REQUIRED_LOGINS=
# Comma-separated YubiKey public IDs (first 12 chars of an OTP) allowed to satisfy the above
YUBICO_ALLOWED_PUBLIC_IDS=
